# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alumni_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Alumni System <your_email@gmail.com>

# Security Configuration
PASSWORD_MIN_LENGTH=8
ALLOWED_EMAIL_DOMAIN=unicauca.edu.co
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_TIME=15m
SESSION_SECRET=your_session_secret

# File Upload Configuration
MAX_FILE_SIZE=5242880 # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
UPLOAD_DIR=uploads/

# Monitoring Configuration
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log
MAX_LOG_FILES=5
MAX_LOG_SIZE=5242880 # 5MB in bytes

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW=1h
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Cache Configuration
CACHE_TTL_SHORT=300    # 5 minutes
CACHE_TTL_MEDIUM=3600  # 1 hour
CACHE_TTL_LONG=86400   # 24 hours
CACHE_TTL_VERY_LONG=604800 # 1 week

# Available Careers
CARRERAS=Ingeniería de Sistemas,Ingeniería Electrónica,Ingeniería de Telecomunicaciones,Ingeniería Eléctrica,Ingeniería Mecánica,Ingeniería Civil,Ingeniería Industrial,Ingeniería Química,Ingeniería Ambiental,Ingeniería de Alimentos

# PDF Configuration
PDF_TEMP_DIR=temp
PDF_MAX_PAGES=50
PDF_MAX_SIZE=10485760 # 10MB in bytes

# Notification Configuration
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_DELAY=5000 # 5 seconds

# Search Configuration
SEARCH_MIN_LENGTH=3
SEARCH_MAX_RESULTS=50

# Pagination Configuration
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Export Configuration
EXPORT_MAX_RECORDS=1000
EXPORT_FORMATS=xlsx,csv,pdf

# Backup Configuration
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_SCHEDULE="0 0 * * *" # Daily at midnight